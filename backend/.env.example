# --- Copier en .env (jamais commiter .env) ---

# Clé secrète JWT — OBLIGATOIRE, générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# En production, toute clé < 32 caractères ou égale à la valeur par défaut
# entraîne une erreur au démarrage.
SECRET_KEY=CHANGE_ME_IN_DOT_ENV

# Base de données SQLite (chemin relatif au répertoire d'exécution backend/)
DATABASE_URL=sqlite+aiosqlite:///./data/atlas.db

# Origines CORS autorisées (séparées par une virgule)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durée de vie du token JWT (secondes) — 1 heure par défaut
JWT_EXPIRE_SECONDS=3600

# Environnement : development | production
# En production : SECRET_KEY forte obligatoire, /docs désactivé, cookie secure=True
ENVIRONMENT=development
