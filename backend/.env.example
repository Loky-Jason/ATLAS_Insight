# --- Copier en .env (jamais commiter .env) ---

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-first-run

# Base de données SQLite (chemin relatif au répertoire d'exécution backend/)
DATABASE_URL=sqlite+aiosqlite:///./data/atlas.db

# Origines CORS autorisées (séparées par une virgule)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durée de vie du token JWT (secondes) — 8 heures par défaut
JWT_EXPIRE_SECONDS=28800

# Environnement : development | production
ENVIRONMENT=development
